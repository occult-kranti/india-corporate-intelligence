{
  "name": "india-corporate-intelligence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "promote": "node scripts/promote.mjs",
    "generate": "node scripts/assemble-fleet.mjs",
    "test:assemble": "node --test scripts/assemble-fleet.test.mjs scripts/merge-fleet.test.mjs",
    "test:security-view": "node --test scripts/security-view.test.mjs",
    "check:skills": "node scripts/skills/force-money-trail/gen.mjs > /dev/null && git diff --exit-code -- .claude/skills/force-money-trail",
    "validate": "node scripts/validate.mjs",
    "smoke": "node scripts/smoke.mjs",
    "viewport": "node scripts/graph-viewport.mjs",
    "check": "npm run promote && npm run generate && npm run test:assemble && npm run test:security-view && npm run validate && npm run check:skills && npm run build && npm run smoke && npm run viewport && npm run test:pages",
    "test:pages": "node --test scripts/pages/energy.test.mjs scripts/pages/welfare.test.mjs scripts/pages/tenders.test.mjs scripts/pages/finance.test.mjs scripts/pages/security.test.mjs"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "d3-quadtree": "^3.0.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/d3-force": "^3.0.10",
    "@types/d3-quadtree": "^3.0.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  }
}
