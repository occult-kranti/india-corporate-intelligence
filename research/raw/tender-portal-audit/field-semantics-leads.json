  "selectionSQL": "SELECT n.internal_id AS notice_internal_id,a.internal_id AS award_internal_id,n.portal,n.buyer,n.tender_id,k.reference_key AS reference,n.title,n.tender_category,n.product_category,n.tender_type,n.status,n.published_at,n.closing_at AS notice_closing,a.closing_at AS award_closing,a.aoc_at,a.bids_raw,a.value_raw,a.value_amount,date_diff('minute',n.published_at,n.closing_at)/60.0 AS listed_window_hours,nullif(trim(n.corrigendum_url),'') IS NOT NULL AS corrigendum_link,n.document_url AS notice_document_url,a.document_url AS award_document_url FROM unique_pairs p JOIN audit.notices n ON n.internal_id=p.notice_internal_id JOIN audit.awards a ON a.internal_id=p.award_internal_id JOIN award_keys k ON k.internal_id=a.internal_id WHERE n.published_at>=TIMESTAMP '2021-06-16' AND n.published_at<=n.closing_at AND n.closing_at<=a.aoc_at AND a.aoc_at<=a.scraped_at AND regexp_full_match(n.tender_id,'[0-9]{4}_[A-Za-z][A-Za-z0-9]*_[0-9]+_[0-9]+') AND regexp_full_match(trim(a.bids_raw),'[0-9]+') AND try_cast(trim(a.bids_raw) AS INTEGER) BETWEEN 1 AND 1000 AND regexp_full_match(trim(a.value_raw),'[0-9]+(?:\\.[0-9]+)?') AND a.value_amount BETWEEN 100000 AND 10000000000 ORDER BY CASE WHEN cast(a.bids_raw AS INTEGER)=1 AND date_diff('minute',n.published_at,n.closing_at)<72*60 THEN 0 ELSE 1 END,listed_window_hours,n.tender_id LIMIT 12",
