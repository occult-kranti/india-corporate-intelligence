<script>
const dropdown = document.getElementById('bhashiniLanguageDropdown');

if (dropdown) {
  dropdown.addEventListener('click', function (event) {
    const selectedOption = event.target.closest('.language-option');
    if (selectedOption) {
      const selectedLang = selectedOption.getAttribute('data-value');
      console.log('Selected language:', selectedLang);
    }
  });
} else {
  console.warn('Default language:', 'hi');
}
</script>
