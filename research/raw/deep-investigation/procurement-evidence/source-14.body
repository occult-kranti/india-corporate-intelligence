		function callPrint(){
			window.print();
		}
		// Script to view document in popup
     function popUp(obElm, sFeature){
	var sLink;

	if(typeof(obElm) == 'string'){
		sLink = obElm;
	}
	else{
		sLink = obElm.href;
		
		var obWin = window.open(sLink, "ChildPopup", sFeature);
		
		obWin.focus();
		
		if(!obWin.opener) obWin.opener = _self;
		
		return false;
	}

}
		function popup(mylink, windowname)
			{
				if (! window.focus)return true;
				var href;
			if (typeof(mylink) == 'string')
   				href=mylink;
			else
  				 href=mylink.href;
				window.open(href, "Popup", 'location=no, scrollbars=yes, toolbar=no, width=800, height=400, directories=no, menubar=no, resizable=yes, status=no, titlebar=yes');
					return false;   
			}

	</script>
