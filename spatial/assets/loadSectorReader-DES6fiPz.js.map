export default "{\n  \"financialContext\": [\n    {\n      \"packet\": \"welfare-food-finance\",\n      \"sourceId\": \"welfare-food-finance:icr\",\n      \"locator\": \"Printed p19 / PDF p23, paragraph 61\",\n      \"text\": \"UN-agency advances were reportedly settled within the extended grace period ending 31 January 2020; this is an administrative milestone, not WFP-specific final utilization, refunds, fees or supplier reconciliation.\"\n    },\n    {\n      \"packet\": \"welfare-food-finance\",\n      \"sourceId\": \"welfare-food-finance:isr01\",\n      \"locator\": \"Printed/PDF p7\",\n      \"text\": \"Project-wide $33.23m disbursed and $18.82m undisbursed exceed the $50m original USD equivalent when added; denomination/date reconciliation remains unresolved. Exchange-rate effects are plausible, not established.\"\n    },\n    {\n      \"packet\": \"welfare-food-finance\",\n      \"sourceId\": \"welfare-food-finance:icr\",\n      \"locator\": \"Printed p2 / PDF p6; IEG p1\",\n      \"text\": \"Final project disbursement is $50,243,624 in ICR and $50,243,624.03 in IEG. Neither is a WFP-specific final utilization figure.\",\n      \"additionalSources\": [\n        {\n          \"sourceId\": \"welfare-food-finance:ieg\",\n          \"locator\": \"p1\"\n        }\n      ]\n    },\n    {\n      \"packet\": \"energy-mineral-finance\",\n      \"sourceId\": \"energy-mineral-finance:annual-2025.html\",\n      \"locator\": \"Note 3; printed p81 cash-flow statement\",\n      \"text\": \"$435m reported cash advance, $438.761m year-end principal including $3.761m deferred interest, and $350.987m accounting carrying value after $87.774m issuance costs are different stages, never three cash payments.\"\n    },\n    {\n      \"packet\": \"energy-mineral-finance\",\n      \"sourceId\": \"energy-mineral-finance:annual-2025.html\",\n      \"locator\": \"Note 4; printed p81 cash-flow statement; Item 1 closing narrative\",\n      \"text\": \"Issuer reports $330m GM cash at 20 December 2024 closing and $100m at 1 April 2025 FID; $195m LC facility released to LN on 5 August 2025 is credit support, not cash or extinguishment. $625m package comprises $430m cash and $195m credit support. Item 1 says 23 December closing versus Note 4’s 20 December; unresolved.\"\n    },\n    {\n      \"packet\": \"energy-mineral-finance\",\n      \"sourceId\": \"energy-mineral-finance:ffb-note-purchase-agreement.html\",\n      \"locator\": \"Article 1; section 7.1\",\n      \"text\": \"Original $2,259,687,000 commitment and revised roughly $2.23bn headline include estimated capitalized interest; neither is cash received. Conditional commitment 14 March 2024, closing 28 October 2024 and 20 October 2025 first-draw announcement are distinct. That announcement date is not an independently established transfer date.\",\n      \"additionalSources\": [\n        {\n          \"sourceId\": \"energy-mineral-finance:conditional-commitment.html\",\n          \"locator\": \"14 March 2024 announcement\"\n        },\n        {\n          \"sourceId\": \"energy-mineral-finance:closing-announcement.html\",\n          \"locator\": \"28 October 2024 announcement\"\n        },\n        {\n          \"sourceId\": \"energy-mineral-finance:draw-announcement.html\",\n          \"locator\": \"20 October 2025 announcement\"\n        }\n      ]\n    },\n    {\n      \"packet\": \"rss-report-review\",\n      \"sourceId\": \"rss-report-review:report\",\n      \"locator\": \"All 39 physical PDF pages, independent bounded visual review\",\n      \"text\": \"No auditor opinion or consolidated annual-income/transfer ledger was located in this inspected file. This does not establish nonexistence elsewhere, reporting duties or noncompliance. Local monetary mentions and physical quantities cannot be combined into national receipts.\"\n    }\n  ],\n  \"schemaVersion\": 1,\n  \"mode\": \"local-reader-stage\",\n  \"publicationStatus\": \"awaiting-parent-content-review\",\n  \"graphEligible\": false,\n