\"dates\": {\n        \"reportPeriod\": \"2025–26\",\n        \"eventOrMeasurement\": null\n      },\n      \"qualifications\": [\n        \"No total collection ledger; do not multiply into confirmed receipts.\",\n        \"Organization-reported statement, not independent corroboration.\",\n        \"Counts are not offices, members, legal entities or unique people; no summation or conversion.\"\n      ],\n      \"unresolved\": [\n        \"Independent corroboration\"\n      ],\n      \"moneyStages\": [\n        {\n          \"stage\": \"Local price\",\n          \"amount\": null,\n          \"currency\": null,\n          \"valueAsReported\": \"Two saplings per household upon payment of Rs 25.\",\n          \"overlapGroup\": \"unrelated-local-RSS-programmes\",\n          \"notAuditedCashProof\": true\n        }\n      ],\n      \"aggregationPermitted\": false,\n      \"graphEligible\": false,\n      \"pathEligible\": false,\n      \"publicationStatus\": \"awaiting-parent-content-review\",\n      \"criticismResponseIds\": [],\n      \"sourceRecordPointer\": {\n        \"file\": \"candidate-claims.json\",\n        \"id\": \"RSS-2026-010\"\n      }\n    },\n    {\n      \"id\": \"RSS-2026-011\",\n      \"packet\": \"rss-report-review\",\n      \"claimText\": \"Cash prizes listed as Rs 100,000, 50,000, 25,000 and 10,000; 480,000 books distributed for 10 each.\",\n      \"claimTextType\": \"qualified_reader_paraphrase_not_verbatim_source_quote\",\n      \"sources\": [\n        {\n          \"sourceId\": \"rss-report-review:report\",\n          \"locator\": \"Physical PDF p30; printed 57\"\n        }\n      ],\n      \"dates\": {\n        \"reportPeriod\": \"2025–26\",\n        \"eventOrMeasurement\": null\n      },\n      \"qualifications\": [\n        \"Price currency not repeated; total awards, payer/payee, collections and costs not established.\",\n        \"Organization-reported statement, not independent corroboration.\",\n        \"Counts are not offices, members, legal entities or unique people; no summation or conversion.\"\n      ],\n      \"unresolved\": [\n        \"Independent corroboration\"\n      ],\n      \"moneyStages\": [\n        {\n          \"stage\": \"Local prizes and distribution price\",\n          \"amount\": null,\n          \"currency\": null,\n          \"valueAsReported\": \"Cash prizes listed as Rs 100,000, 50,000, 25,000 and 10,000; 480,000 books distributed for 10 each.\",\n          \"overlapGroup\": \"unrelated-local-RSS-programmes\",\n          \"notAuditedCashProof\": true\n        }\n      ],\n      \"aggregationPermitted\": false,\n      \"graphEligible\": false,\n      \"pathEligible\": false,\n      \"publicationStatus\": \"awaiting-parent-content-review\",\n      \"criticismResponseIds\": [],\n      \"sourceRecordPointer\": {\n        \"file\": \"candidate-claims.json\",\n        \"id\": \"RSS-2026-011\"\n      }\n    }\n  ],\n  \"criticismResponses\": [\n    {\n      \"id\": \"wff-criticism-1\",\n      \"packet\": \"welfare-food-finance\",\n      \"criticism\": \"Computerized accounting unused; gaps in FM manual; weak internal-audit oversight; FAO final certified report late.\",\n      \"response\": \"ICR says audit opinions clean/unqualified and UN agency systems mitigated risks, with more than 90% of funds handled by agencies; advances settled within extended grace period ending 2020-01-31. Underlying audit report and management letter not acquired.\",\n      \"locator\": \"icr paragraph 61, printed p19 / PDF p23\",\n      \"sourceId\": \"welfare-food-finance:icr\",\n      \"status\": \"Published evaluation observation, not corruption finding\"\n    },\n    {\n      \"id\": \"wff-criticism-2\",\n      \"packet\": \"welfare-food-finance\",\n      \"criticism\": \"Contract rectified twice; supervision could not obtain all required safeguards records.\",\n      \"response\": \"ICR says grievance mechanism addressed concerns but documentation was weak. Unnamed company deliberately not inferred.\",\n      \"locator\": \"icr paragraph 60, printed p19 / PDF p23\",\n      \"sourceId\": \"welfare-food-finance:icr\",\n      \"status\": \"Published evaluation observation\"\n    },\n    {\n      \"id\": \"wff-criticism-3\",\n      \"packet\": \"welfare-food-finance\",\n      \"criticism\": \"Physical delivery coverage better documented than welfare improvement, yield impact or whether intended people received benefits.\",\n      \"response\": \"IEG acknowledges emergency/security constraints and rates M&E Substantial, whereas ICR rates M&E Modest. Preserve the disagreement; neither supplies independent transaction verification.\",\n      \"locator\": \"ieg section 9, printed/PDF pp11–12\",\n      \"sourceId\": \"welfare-food-finance:ieg\",\n      \"status\": \"Evaluation limitation; weakens causal welfare claims\"\n    },\n    {\n      \"id\": \"wff-criticism-4\",\n      \"packet\": \"welfare-food-finance\",\n      \"criticism\": \"No open-competition inference warranted.\",\n      \"response\": \"Emergency rationale, prior review and existing UN operational capacity documented; ICR reports no procurement-performance issue.\",\n      \"locator\": \"icr paragraph 62, printed p19 / PDF p23\",\n      \"sourceId\": \"welfare-food-finance:icr\",\n      \"status\": \"Analytical scrutiny question, not allegation of violation\"\n    },\n    {\n      \"id\": \"emf-environment\",\n      \"packet\": \"energy-mineral-finance\",\n      \"criticism\": \"DOE records opposition submissions; court acknowledges habitat loss and groundwater-data discrepancies.\",\n      \"response\": \"DOE records responses; court treated the discrepancies as nonmaterial and preserved remand without vacatur. These bounded determinations do not establish no harm, unanimous tribal consent, later loan validity or corruption.\",\n      \"sourceId\": \"energy-mineral-finance:doe-rod.pdf\",\n      \"locator\": \"DOE ROD pp8–9; scope limits pp2–5\",\n      \"additionalSources\": [\n        {\n          \"sourceId\": \"energy-mineral-finance:court-2023.pdf\",\n          \"locator\": \"p1 nonprecedential; p7 habitat; p8 footnote 3; pp9–10 remand; p11 footnote 4\"\n        }\n      ],\n      \"status\": \"Regulatory/judicial responses answer different questions, not transaction corroboration\"\n    },\n    {\n      \"id\": \"emf-recourse\",\n      \"packet\": \"energy-mineral-finance\",\n      \"criticism\": \"Guarantees, qualified non-recourse protections, redactions and annex forms prevent blanket recourse conclusions.\",\n      \"response\": \"Sponsor completion/debt guarantees and distinct termination conditions must be read together; obtain clean operative instruments and perfection records. Citibank is collateral agent, not lender or beneficial owner.\",\n      \"sourceId\": \"energy-mineral-finance:omnibus-2025.html\",\n      \"locator\": \"Amended support sections 3.01, 3.09, 10.08; preamble\",\n      \"status\": \"Unresolved legal-document scope; no fresh legal opinion\"\n    }\n  ]\n}\n"