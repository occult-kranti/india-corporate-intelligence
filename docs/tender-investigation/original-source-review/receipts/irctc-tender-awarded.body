        if (localStorage.getItem("chatBoxMaximized") === "true") {
            $(".chat-box").addClass("maximized");
            $(".chat-box-maximize").hide();
            $(".chat-box-minimize").show();
        }

        $(".chat-box-maximize").on("click", function () {
            $(".chat-box").addClass("maximized");
            $(".chat-box-maximize").hide();
            $(".chat-box-minimize").show();
            localStorage.setItem("chatBoxMaximized", "true");
        });

        $(".chat-box-minimize").on("click", function () {
            $(".chat-box").removeClass("maximized");
            $(".chat-box-minimize").hide();
            $(".chat-box-maximize").show();
            localStorage.setItem("chatBoxMaximized", "false");
        });

        $(".chat-box-minimize").on("click", function () {
            $(".chat-box").addClass("minimize");
            $(".chat-box-minimize").hide();
            $(".chat-box-maximize").show();
            localStorage.setItem("chatBoxMaximized", "false");
        });


        $("#chat-circle").on("click", function () {
            //$(".chat-box").fadeIn(); // Show the chat box
            // Reset state to minimized (so that maximize button is shown)
            $(".chat-box").removeClass("maximized");
            $(".chat-box-maximize").show();
            $(".chat-box-minimize").hide();
        });

        $('.chat-box-toggle').on('click', function () {
            $('.chat-box').removeClass('minimize');
        });


        // Optional: Close the chat box
        // $(".chat-box-toggle").on("click", function() {
        //     $(".chat-box").fadeOut();
        // });

        // $(".output-value").click(function() {
        //     console.log("Element clicked!");
        //     var question = $(this).data("question");
        //     alert(question);
        // });

        $("#chat-submit").click(function (event) {
            var inputValue = $("#chat-input").val();
            event.preventDefault();
            if (inputValue.trim() !== '') {
                handleChatInput(inputValue);
                $.ajax({

                    url: "save_chat.php",
                    type: "POST",
                    data: { message: inputValue },
                    success: function (response) {
                        $("#chat-input").val('');
                    },
                    error: function (xhr, status, error) {
                        console.log("An error occurred while sending the message.");
                    }

                });
            } else {
                alert("Please enter a message.");
            }
        });

        // Click event for chat options
        $(document).on('click', '.chat-option a', function (event) {
            event.preventDefault();
            var optionValue = $(this).text();
            handleChatInput(optionValue);
        });
        let shouldScroll = true;
        function handleChatInput(inputValue) {
        debugger;
            $('.msger-box').animate({ scrollTop: $('.msger-box')[0].scrollHeight }, 100);
            $(".loading-div").html('');
            // Sanitize the input (strip HTML tags)
            inputValue = sanitizeInput(inputValue);
            $(".chat-div").append('<div class="msg right-msg"><div class="msg-img"><img src="images/chat-logo2.svg" alt=""></div><div class="msg-bubble"><div class="msg-text input-value" id="input-id" style="color:white">' + inputValue + '</div></div></div>');
            if ($(".chat-div").children().length > 0) {
                $('.msger-box').animate({ scrollTop: $('.msger-box')[0].scrollHeight }, 100);
            }
            //$(".chat-div .msg").last()[0].scrollIntoView({ behavior: "smooth" });
            // setTimeout(function() {
            // $('.msger-box').animate({ scrollTop: $('.msger-box')[0].scrollHeight + 1000 }, 100);  // Scroll down with a slight offset
            // }, 500); 
            $.ajax({
                type: "POST",
                url: "message.php",
                data: { message: inputValue },
                beforeSend: function () {
                    $(".loading-div").html("<div class=''> <span class='loading-dot'></span><span class='loading-dot'></span><span class='loading-dot'></span></div>");
                },
                success: function (response) {
                    $('.msger-box').animate({ scrollTop: $('.msger-box')[0].scrollHeight }, 100);
                    setTimeout(function () {
                        if ($(".chat-div").is(':empty')) {
                            $('.msger-box').animate({ scrollTop: $('.msger-box')[0].scrollHeight }, 100);

                        }
                        $(".loading-div").html('');
                        $(".chat-div").append(response).show();
                        $("#chat-input").val('');
                    }, 1000);
                },
                error: function (xhr, status, error) {
                    console.log("Error: " + error + "\nStatus: " + status + "\nResponse: " + xhr.responseText);
                     $(".loading-div").html('');          // remove loading animation
                 $('.chat-div').empty();
                 $("#chat-input").val('');
                 return;
                }
            });
        }
        // Function to sanitize HTML or script input
        function sanitizeInput(input) {
            debugger;
            // Remove <, >, and quotes to neutralize any HTML/script injection
            return input
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
        $('#refresh-icon').on('click', function () {
            $('.chat-div').empty();
            $("#chat-input").val('');
        });



    });
</script>

      <script src="js/bootstrap.bundle.min.js"></script>
      <script src="js/plugins.js"></script>
      <script src="js/gsap.min.js"></script>
      <script src="js/aos.js"></script>
      <script src="js/all-inside.js"></script>
      <script src="js/home.js"></script>
      <script type="text/javascript" src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
      <script src="js/menu.js"></script>
</body>
</html>
