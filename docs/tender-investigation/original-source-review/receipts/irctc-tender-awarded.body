<script>
    $(document).ready(function () {
        $(document).on('click', function (event) {
            if (!$(event.target).closest('.hl-rightPanel-tab').length) {
                if ($('.hl-rightPanel-wrap').hasClass('hl-rightPanel-open')) {
                    $('.hl-rightPanel-wrap').removeClass('hl-rightPanel-open');
                    $('.hl-rightPanel-tab').removeClass('hl-rightPanel-tab-selected');

                }
            }
        });
    });
</script>
<script>
    $(document).ready(function () {

