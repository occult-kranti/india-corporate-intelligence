<!-- Progress Bar Button JavaScript -->
<script>
   document.addEventListener('DOMContentLoaded', function () {
      const progressWrap = document.querySelector('.progress-wrap');
      const progressPath = document.querySelector('.progress-circle path');
      const pathLength = progressPath ? progressPath.getTotalLength() : 0;

      // Initialize SVG path for progress circle
      if (progressPath) {
         progressPath.style.strokeDasharray = pathLength;
         progressPath.style.strokeDashoffset = pathLength;
      }

      // Update progress bar on scroll
      function updateProgress() {
         const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
         const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
         const scrollFraction = docHeight > 0 ? scrollTop / docHeight : 0;
         const offset = pathLength * (1 - scrollFraction);
         if (progressPath) {
            progressPath.style.strokeDashoffset = offset;
         }

         // Show/hide button based on scroll position
         if (progressWrap && scrollTop > 100) {
            progressWrap.classList.add('active-progress');
         } else if (progressWrap) {
            progressWrap.classList.remove('active-progress');
         }
      }

      // Scroll to top on click
      if (progressWrap) {
         progressWrap.addEventListener('click', function (e) {
            e.preventDefault();
            window.scrollTo({
               top: 0,
               behavior: 'smooth'
            });
         });
      }

      // Update progress on scroll
      window.addEventListener('scroll', updateProgress);

      // Initial call to set progress
      updateProgress();
   });


